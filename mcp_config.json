{
    "mcpServers": {
        "supabase": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-supabase"
            ],
            "env": {
                "SUPABASE_URL": "YOUR_SUPABASE_URL",
                "SUPABASE_SERVICE_ROLE_KEY": "YOUR_SUPABASE_KEY"
            }
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
            }
        },
        "airtable": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-airtable"
            ],
            "env": {
                "AIRTABLE_API_KEY": "YOUR_AIRTABLE_KEY"
            },
            "disabled": true,
            "comment": "Official Airtable MCP server not found via npm. Check for community packages or remove."
        },
        "followup-boss": {
            "command": "npx",
            "args": [
                "-y",
                "@aarondott/mcp-server-followupboss"
            ],
            "env": {
                "FUB_API_KEY": "YOUR_FUB_API_KEY"
            }
        }
    }
}